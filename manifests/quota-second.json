{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "quota-second",
    "namespace": "skills-quota"
  },
  "spec": {
    "restartPolicy": "Never",
    "terminationGracePeriodSeconds": 2,
    "automountServiceAccountToken": false,
    "containers": [
      {
        "name": "hold",
        "image": "skills-1c:lab5",
        "imagePullPolicy": "Never",
        "command": [
          "python",
          "-c",
          "import time; time.sleep(1800)"
        ],
        "resources": {
          "requests": {
            "cpu": "500m",
            "memory": "16Mi"
          },
          "limits": {
            "cpu": "500m",
            "memory": "64Mi"
          }
        }
      }
    ]
  }
}
